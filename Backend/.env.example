# ==========================================================
# AI Company OS - backend environment
# Copy to .env and fill in. Never commit the real .env.
# ==========================================================

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------

# Local development (native PostgreSQL service on Windows):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_company_os"

# Deployment - use Neon's POOLED host (it contains "-pooler."), which survives
# the connection recycling that a direct URL does not.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Sign JWTs. Must be long and random; the app refuses to start without it.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=""

# Log every SQL statement. True is very noisy and billable on a hosted platform.
DB_ECHO=false

# Pool sizing. Keep the total low: Neon's pooler and free compute both cap it.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

# Comma-separated. allow_credentials is enabled, so "*" is not accepted here -
# every origin must be spelled out, including the scheme.
# Production example:
# CORS_ORIGINS="https://your-app.vercel.app,https://your-app.netlify.app"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ----------------------------------------------------------
# MODEL PROVIDERS
# ----------------------------------------------------------

OPENROUTER_API_KEY=""
GOOGLE_API_KEY=""
GROQ_API_KEY=""
XAI_API_KEY=""
TAVILY_API_KEY=""
BAI_API_KEY=""

# ----------------------------------------------------------
# LANGSMITH TRACING (optional)
# ----------------------------------------------------------

LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=""
LANGCHAIN_ENDPOINT=""
