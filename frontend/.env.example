# Copy to .env for local development. The file you copy into is ignored by git.
#
# Everything VITE_ is inlined into the browser bundle at build time. Never put a
# secret here - the API key for this backend must live in the backend's .env,
# not here, or it is public to anyone who views the page source.

# Local development backend
VITE_API_URL=http://localhost:8000

# Production: leave this file alone and set VITE_API_URL in the host's dashboard
# (Vercel: Settings -> Environment Variables). It is read at BUILD time, not
# runtime, so changing it on the host requires a redeploy, not just a restart.
